APP_NAME="Spoedverhuur"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://spoedverhuur.sorai.nl
APP_TIMEZONE=Europe/Amsterdam
APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

# Deploy-sleutel voor __pull_deploy.php / __migrate.php / __log.php
DEPLOY_SECRET=

# Boels CORE (identity provider; rollen worden daar beheerd)
CORE_URL=https://databasehub.sorai.nl
CORE_APP_SLUG=spoedverhuur
CORE_CACHE_SECONDS=300
# Alleen lokaal: nep-gebruiker met alle rollen (nooit op de server op true)
CORE_DEV_FAKE_USER=false

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Eigen SQLite-database (staat buiten public_html; wordt nooit door een deploy overschreven)
DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Mail: zelfde SMTP-mailbox als Boels CORE (wordt bij de eerste deploy uit CORE overgenomen)
MAIL_MAILER=log
MAIL_HOST=mail.antagonist.nl
MAIL_PORT=465
MAIL_USERNAME=noreply@sorai.nl
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@sorai.nl"
MAIL_FROM_NAME="${APP_NAME}"
